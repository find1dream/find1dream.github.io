---
// Line drawings for the project cards. Monochrome + one accent, theme tokens only.
type Kind = 'system' | 'control' | 'docking' | 'bev' | 'edge' | 'sensor';
const { kind } = Astro.props as { kind: Kind };

// --- bev: occupancy grid (16 x 9 cells of 20 px) ---
const occupied = (x: number, y: number) =>
  x <= 1 || x >= 14 || (x >= 9 && x <= 11 && y >= 4 && y <= 6) || (x >= 4 && x <= 6 && y >= 2 && y <= 3);
const cells: { x: number; y: number; occ: boolean }[] = [];
for (let y = 0; y < 9; y++) for (let x = 0; x < 16; x++) cells.push({ x: x * 20 + 1, y: y * 20 + 1, occ: occupied(x, y) });

// --- sensor: waveforms ---
const wave = (base: number, f: (x: number) => number) => {
  let s = '';
  for (let x = 64; x <= 304; x += 2) s += (x === 64 ? 'M' : 'L') + x + ' ' + (base + f(x)).toFixed(1);
  return s;
};
const w1 = wave(48, (x) => -3 * Math.sin(x / 4) - 14 * Math.sin(x / 5) * Math.exp(-((x - 190) ** 2) / 500));
const w2 = wave(102, (x) => (x > 130 && x < 160) || (x > 236 && x < 252) ? -12 : 4);
const w3 = wave(156, (x) => -(2 + 12 * Math.exp(-((x - 120) ** 2) / 300)) * Math.sin(x / 2.2));

// --- edge: chip pins ---
const pinPath = Array.from({ length: 5 }, (_, i) => {
  const a = 52 + i * 14; // along top/bottom
  const b = 62 + i * 14; // along left/right
  return `M${a} 52L${a} 44M${a} 132L${a} 140M40 ${b}L32 ${b}M120 ${b}L128 ${b}`;
}).join('');
---
<svg class="schem" viewBox="0 0 320 200" role="img" aria-hidden="true">
  <defs>
    <symbol id={`rb-${kind}`} viewBox="-16 -16 32 32" overflow="visible">
      <rect x="-5.5" y="-16" width="11" height="4.5" rx="1.5" fill="var(--ink)" />
      <rect x="-5.5" y="11.5" width="11" height="4.5" rx="1.5" fill="var(--ink)" />
      <circle r="13" fill="var(--bg)" stroke="var(--ink)" stroke-width="1.6" />
      <path d="M8.5 -8.5 A 12 12 0 0 1 8.5 8.5" fill="none" stroke="var(--accent)" stroke-width="2.6" stroke-linecap="round" />
      <circle r="4" fill="none" stroke="var(--muted)" stroke-width="1.3" />
      <circle r="1.6" fill="var(--muted)" />
    </symbol>
    <marker id={`ar-${kind}`} viewBox="0 0 8 8" refX="6" refY="4" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 0 L8 4 L0 8 z" fill="var(--accent)" />
    </marker>
  </defs>

  {kind === 'system' && (
    <g>
      {/* 7 layers, top to bottom, each wired to the Zenoh bus on the right */}
      <rect class="box" x="36" y="12" width="196" height="20" rx="4" /><text class="lbl" x="134" y="26" text-anchor="middle">application</text>
      <rect class="box" x="36" y="40" width="94" height="20" rx="4" /><text class="lbl" x="83" y="54" text-anchor="middle">decision</text>
      <rect class="box" x="138" y="40" width="94" height="20" rx="4" /><text class="lbl" x="185" y="54" text-anchor="middle">observer</text>
      <rect class="box" x="36" y="68" width="94" height="20" rx="4" /><text class="lbl" x="83" y="82" text-anchor="middle">perception</text>
      <rect class="box" x="138" y="68" width="94" height="20" rx="4" /><text class="lbl" x="185" y="82" text-anchor="middle">localization</text>
      <rect class="box hl" x="36" y="96" width="196" height="20" rx="4" /><text class="lbl ink" x="134" y="110" text-anchor="middle">control</text>
      <rect class="box" x="36" y="124" width="196" height="20" rx="4" /><text class="lbl" x="134" y="138" text-anchor="middle">hardware abstraction</text>
      <line class="acc" x1="266" y1="14" x2="266" y2="142" />
      {[22, 50, 78, 106, 134].map((y) => (
        <g><line class="wire" x1="232" y1={y} x2="266" y2={y} /><circle cx="266" cy={y} r="3" fill="var(--accent)" /></g>
      ))}
      <text class="lbl acc-t" x="274" y="82">Zenoh</text>
      <line class="wire" x1="134" y1="144" x2="134" y2="156" />
      <text class="lbl" x="134" y="168" text-anchor="middle">LiDAR · cameras · motors · units</text>
      <text class="lbl" x="16" y="192">layered · one-step update · auto rollback</text>
    </g>
  )}

  {kind === 'control' && (
    <g>
      <text class="lbl" x="16" y="24">robot · cart · reference path</text>
      <path class="ln" d="M16 172 C 100 172, 128 170, 168 130 S 220 44, 304 40" />
      <path class="acc" d="M133 158 L139 153 L151 146 L168 130 L181 115 L194 100 L209 82" stroke-dasharray="2 5" stroke-linecap="round" fill="none" />
      {[[139, 153], [151, 146], [168, 130], [181, 115], [194, 100], [209, 82]].map(([x, y], i) => (
        <circle cx={x} cy={y} r="2.6" fill="var(--accent)" opacity={1 - i * 0.13} />
      ))}
      {/* round robot towing a cart behind it, sitting on the path */}
      <g transform="translate(121 162) rotate(-17)">
        <rect class="box" x="-62" y="-13" width="36" height="26" rx="2" />
        {[[-58, -15], [-34, -15], [-58, 13], [-34, 13]].map(([x, y]) => <rect x={x} y={y - 1.5} width="6" height="3" rx="1" fill="var(--muted)" />)}
        <line class="ln ink-s" x1="-26" y1="0" x2="-12" y2="0" />
        <use href={`#rb-${kind}`} x="-14" y="-14" width="28" height="28" />
      </g>
      <text class="lbl" x="216" y="84">prediction</text>
    </g>
  )}

  {kind === 'docking' && (
    <g>
      <line class="grid" x1="160" y1="14" x2="160" y2="170" />
      <text class="lbl ink" x="16" y="26">1 · dock</text>
      <text class="lbl ink" x="172" y="26">2 · tow</text>
      {/* 1: robot reverses toward the cart, rear camera on the markers */}
      <rect class="box" x="98" y="60" width="44" height="60" rx="3" />
      <rect x="99" y="68" width="10" height="10" fill="var(--ink)" /><rect x="102" y="71" width="4" height="4" fill="var(--bg)" />
      <rect x="99" y="102" width="10" height="10" fill="var(--ink)" /><rect x="102" y="105" width="4" height="4" fill="var(--bg)" />
      <use href={`#rb-${kind}`} x="30" y="72" width="36" height="36" transform="rotate(180 48 90)" />
      <rect x="64" y="86" width="5" height="8" rx="1" fill="var(--accent)" />
      <path class="ln" d="M69 90 L99 73 M69 90 L99 107" stroke-dasharray="3 3" />
      <path class="acc" d="M36 128 L76 128" marker-end={`url(#ar-${kind})`} />
      <text class="lbl" x="34" y="146">reverse</text>
      {/* 2: coupled, robot pulls the cart away */}
      <line class="ln ink-s" x1="214" y1="90" x2="232" y2="90" />
      <use href={`#rb-${kind}`} x="182" y="72" width="36" height="36" transform="rotate(180 200 90)" />
      <rect class="box" x="232" y="60" width="44" height="60" rx="3" />
      <rect x="233" y="68" width="10" height="10" fill="var(--ink)" /><rect x="233" y="102" width="10" height="10" fill="var(--ink)" />
      <path class="acc" d="M224 128 L184 128" marker-end={`url(#ar-${kind})`} />
      <text class="lbl" x="184" y="146">attach · pull</text>
      <text class="lbl" x="16" y="192">rear camera · markers · auto attach / detach</text>
    </g>
  )}

  {kind === 'bev' && (
    <g>
      {cells.map((c) => (
        <rect x={c.x} y={c.y} width="18" height="18" rx="2" class={c.occ ? 'occ' : 'free'} />
      ))}
      <path d="M160 158 C 158 122, 148 102, 156 80 S 170 40, 176 6" fill="none" stroke="var(--accent)" stroke-width="16" stroke-linecap="round" opacity=".16" />
      <path class="acc" d="M160 158 C 158 122, 148 102, 156 80 S 170 40, 176 6" />
      <use href={`#rb-${kind}`} x="148" y="154" width="24" height="24" transform="rotate(-90 160 166)" />
      <text class="lbl" x="10" y="194">AI-predicted safe path · occupied cells</text>
    </g>
  )}

  {kind === 'edge' && (
    <g>
      <path class="ln" d={pinPath} />
      <rect class="box ink-s" x="40" y="52" width="80" height="80" rx="6" />
      {[[62, 74], [62, 92], [62, 110], [80, 83], [80, 101], [98, 92]].map(([x, y]) => <circle cx={x} cy={y} r="3" fill="var(--accent)" />)}
      <path d="M62 74L80 83M62 92L80 83M62 92L80 101M62 110L80 101M80 83L98 92M80 101L98 92" stroke="var(--accent)" stroke-width="1" opacity=".55" fill="none" />
      <text class="lbl ink" x="160" y="44">latency per board</text>
      {[['MCU A', 104], ['MCU B', 72], ['MCU C', 46]].map(([n, w], i) => (
        <g>
          <text class="lbl" x="160" y={70 + i * 28}>{n}</text>
          <rect x="200" y={61 + i * 28} width={w} height="12" rx="2" fill="var(--accent)" opacity={1 - i * 0.25} />
        </g>
      ))}
      <text class="lbl" x="16" y="192">model → int8 → profile → benchmark</text>
    </g>
  )}

  {kind === 'sensor' && (
    <g>
      <rect x="170" y="24" width="40" height="46" rx="3" class="hit" />
      <rect x="126" y="80" width="38" height="44" rx="3" class="hit" />
      <rect x="96" y="132" width="50" height="46" rx="3" class="hit" />
      <path class="acc" d={w1} />
      <path class="ln ink-s" d={w2} />
      <path class="ln" d={w3} />
      <text class="lbl" x="16" y="52">radar</text>
      <text class="lbl" x="16" y="106">IR</text>
      <text class="lbl" x="16" y="160">audio</text>
      <text class="lbl" x="16" y="196">on-device event detection</text>
    </g>
  )}
</svg>

<style>
  .schem { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; }
  .box { fill: var(--bg); stroke: var(--muted); stroke-width: 1.2; }
  .box.hl { stroke: var(--accent); stroke-width: 1.6; }
  .ink-s { stroke: var(--ink); }
  .ln { fill: none; stroke: var(--muted); stroke-width: 1.5; }
  .ln.ink-s { stroke: var(--ink); }
  .acc { fill: none; stroke: var(--accent); stroke-width: 2.2; }
  .wire { stroke: var(--muted); stroke-width: 1; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .occ { fill: var(--muted); opacity: .45; }
  .free { fill: var(--bg); }
  .hit { fill: var(--accent-soft); }
  .lbl { fill: var(--muted); font: 500 9.5px var(--f-mono); }
  .lbl.ink { fill: var(--ink); }
  .lbl.acc-t { fill: var(--accent); }
</style>
