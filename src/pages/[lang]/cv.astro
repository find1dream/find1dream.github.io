---
// Print-ready résumé. scripts/cv-pdf.mjs renders this page to public/cv/*.pdf.
import Base from '../../layouts/Base.astro';
import { t, langs, contact, type Lang } from '../../data/content';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t[lang];
---
<Base lang={lang} title={`${c.name} — CV`} description={c.meta.description} path="cv/" noindex>
  <article class="cv">
    <header>
      <div>
        <h1>{c.name}{lang !== 'en' && <span class="alt"> · Linfeng Chen</span>}</h1>
        <p class="role">{c.role}</p>
      </div>
      <ul class="contact">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="12" cy="9.8" r="2.4" fill="currentColor" /></svg>
          <span>{c.location}</span>
        </li>
        <li>
          <a href={`mailto:${contact.email}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M3.5 6.5 12 13l8.5-6.5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            <span>{contact.email}</span>
          </a>
        </li>
        <li>
          <a href={contact.site}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            <span>{contact.site.replace('https://', '')}</span>
          </a>
        </li>
        <li>
          <a href={contact.github}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z" /></svg>
            <span>{contact.github.replace('https://github.com/', '')}</span>
          </a>
        </li>
        {contact.linkedin && (
          <li>
            <a href={contact.linkedin}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" /></svg>
              <span>{contact.linkedin.replace('https://www.linkedin.com/in/', '')}</span>
            </a>
          </li>
        )}
      </ul>
    </header>

    <section>
      <h2>{c.cv.summaryTitle}</h2>
      <p>{c.cv.summary}</p>
    </section>

    <section>
      <h2>{c.cv.workTitle}</h2>
      {c.jobs.map((j) => (
        <div class="job">
          <div class="row"><h3>{j.title} · {j.org}</h3><span class="when">{j.phases ? `${j.when} — ${c.present}` : j.when}</span></div>
          {j.metric && <p class="metric">{j.metric}</p>}
          {j.phases?.map((p) => (
            <div class="phase">
              <div class="row"><h4>{p.title}</h4><span class="when">{p.when.replace(/—$/, `— ${c.present}`)}</span></div>
              <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
          {j.items && <ul>{j.items.map((i) => <li>{i}</li>)}</ul>}
        </div>
      ))}
    </section>

    <section>
      <h2>{c.cv.teamTitle}</h2>
      <ul>{c.cv.team.map((i) => <li>{i}</li>)}</ul>
    </section>

    <section class="two">
      <div>
        <h2>{c.cv.skillsTitle}</h2>
        {c.skills.map((g) => <p><strong>{g.title}</strong>: {g.items.join(' · ')}</p>)}
      </div>
      <div>
        <h2>{c.cv.eduTitle}</h2>
        {c.edu.map((e) => <p><strong>{e.school}</strong> <span class="when">{e.when}</span><br />{e.degree}</p>)}
        <h2 class="sub">{c.cv.langTitle}</h2>
        <p>{c.certs.map((x) => (x.v.includes(x.k) ? x.v : `${x.k}${lang === 'en' ? ': ' : '：'}${x.v}`)).join(' · ')}</p>
      </div>
    </section>

  </article>
</Base>

<style>
  @page { size: A4; margin: 10mm 14mm 8mm; }
  :global(body) { padding: 0 !important; background: #fff !important; color: #111418 !important; }
  .cv { max-width: 780px; margin: 0 auto; padding: 32px 24px; font-size: 9.4pt; line-height: 1.38; color: #111418; --muted: #5f6672; --line: #e2e5ea; --accent: #2b59d9; }
  @media print { .cv { padding: 0; max-width: none; } }
  header { display: flex; justify-content: space-between; gap: 24px; align-items: flex-end; padding-bottom: 12px; border-bottom: 2px solid #111418; }
  h1 { font-size: 22pt; line-height: 1.1; margin: 0; letter-spacing: -0.01em; }
  .alt { font-size: 12pt; font-weight: 500; color: var(--muted); }
  .role { margin: 4px 0 0; color: var(--muted); }
  .contact { list-style: none; margin: 0; padding: 0; text-align: right; display: grid; grid-template-columns: auto auto; gap: 0 14px; font-size: 9pt; color: var(--muted); font-family: var(--f-mono); }
  .contact li { display: flex; justify-content: flex-end; }
  .contact a, .contact li > span { display: inline-flex; align-items: center; gap: 5px; color: inherit; text-decoration: none; }
  .contact li > svg { display: none; }
  .contact li:first-child { gap: 5px; align-items: center; }
  .contact li:first-child > svg { display: inline; }
  .contact svg { width: 10px; height: 10px; flex: none; color: var(--accent); }
  section { margin-top: 11px; break-inside: auto; }
  h2 { font-size: 9pt; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); margin: 0 0 6px; padding-bottom: 3px; border-bottom: 1px solid var(--line); font-weight: 600; }
  h2.sub { margin-top: 12px; }
  h3 { font-size: 11pt; margin: 0; }
  h4 { font-size: 10.5pt; margin: 0; font-weight: 600; }
  p { margin: 0 0 4px; }
  .row { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .when { font-family: var(--f-mono); font-size: 9pt; color: var(--muted); white-space: nowrap; }
  .job { margin-bottom: 7px; break-inside: avoid; }
  .phase { margin-top: 6px; }
  .metric { color: var(--accent); font-weight: 600; margin-top: 2px; }
  ul { margin: 3px 0 0; padding-left: 1.1em; }
  li { margin: 1px 0; }
  .two { display: grid; grid-template-columns: 1.2fr 1fr; gap: 24px; break-inside: avoid; }
</style>
