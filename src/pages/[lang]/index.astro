---
import Base from '../../layouts/Base.astro';
import Schematic from '../../components/Schematic.astro';
import Heatmap from '../../components/Heatmap.astro';
import contrib from '../../data/contrib.json';
import { t, langs, langLabel, contact, cvFile, type Lang } from '../../data/content';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const c = t[lang];
const counts = Object.values(contrib.days as Record<string, number>);
const commits = counts.reduce((a, b) => a + b, 0);
---
<Base lang={lang} title={c.meta.title} description={c.meta.description}>
  <header class="top">
    <div class="wrap bar">
      <a class="mark" href={`/${lang}/`}>Linfeng.Chen</a>
      <nav aria-label="Sections">
        <a href="#about">{c.nav.about}</a>
        <a href="#projects">{c.nav.projects}</a>
        <a href="#work">{c.nav.work}</a>
        <a href="#how">{c.nav.howShort}</a>
        <a href="#contact">{c.nav.contact}</a>
      </nav>
      <button class="theme" type="button" id="theme" aria-label={c.themeLabel} title={c.themeLabel}>
        <svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      </button>
      <div class="lang" role="group" aria-label="Language">
        {langs.map((l) => (
          <a href={`/${l}/`} aria-current={l === lang ? 'page' : undefined} hreflang={l} data-lang={l}>{langLabel[l]}</a>
        ))}
      </div>
    </div>
  </header>

  <main class="wrap">
    <section class="hero">
      <h1>{c.name}</h1>
      <p class="role">{c.role} · {c.location}</p>
      <p class="tagline">{c.tagline}</p>
      <div class="ctas">
        <a class="btn primary" href={cvFile(lang)} download>{c.cvButton} <span class="mono">PDF</span></a>
        <a class="btn" href={contact.github} target="_blank" rel="noopener">GitHub ↗</a>
        {contact.linkedin && <a class="btn" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>}
      </div>
      <p class="cv-other">
        {langs.filter((l) => l !== lang).map((l) => (
          <a href={cvFile(l)} download>{`PDF · ${langLabel[l]}`}</a>
        ))}
      </p>
    </section>

    <p class="stats-head mono">{c.statsTitle}</p>
    <dl class="stats big">
      {c.stats.slice(0, 4).map((s) => (
        <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
      ))}
    </dl>

    <section id="about">
      <h2>{c.nav.about}</h2>
      {c.about.map((p) => <p class="prose">{p}</p>)}
    </section>

    <section id="projects">
      <h2>{c.nav.projects}</h2>
      <div class="cards">
        {c.projects.map((p) => (
          <article class="card">
            <div class="fig"><Schematic kind={p.id} /></div>
            <div class="card-body">
              <p class="when mono">{p.when}</p>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
              {p.nums && (
                <dl class="nums">{p.nums.map((n) => <div><dd>{n.v}</dd><dt>{n.l}</dt></div>)}</dl>
              )}
              <p class="tags">{p.tags.map((tg) => <span>{tg}</span>)}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="work">
      <h2>{c.nav.work}</h2>
      <ol class="jobs">
        {c.jobs.map((j) => (
          <li class="job">
            <div class="when mono">{j.phases ? `${j.when} — ${c.present}` : j.when}</div>
            <div class="job-body">
              <h3>{j.title}</h3>
              <p class="org">{j.org} · {j.place}</p>
              {j.phases?.map((p) => (
                <div class="phase">
                  <p class="phase-head"><span class="mono">{p.when.replace(/—$/, `— ${c.present}`)}</span> {p.title}</p>
                  <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
                </div>
              ))}
              {j.items && <ul>{j.items.map((i) => <li>{i}</li>)}</ul>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="contrib">
      <h2>{c.teamTitle}</h2>
      <dl class="stats small three">
        {c.teamStats.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
      <h2>{c.selfTitle}</h2>
      <dl class="stats small four">
        {c.selfStats.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
      <h3 class="label sub">{c.activity.title}</h3>
      <Heatmap lang={lang} less={c.activity.less} more={c.activity.more} caption={c.activity.caption(commits, counts.length)} />
    </section>

    <section id="how">
      <h2>{c.nav.how}</h2>
      <ol class="principles">
        {c.principles.map((p, i) => (
          <li><span class="idx mono">{String(i + 1).padStart(2, '0')}</span><div><h3>{p.t}</h3><p>{p.d}</p></div></li>
        ))}
      </ol>
    </section>

    <section id="skills">
      <h2>{c.nav.skills}</h2>
      <div class="cols">
        {c.skills.map((g) => (
          <div><h3 class="label">{g.title}</h3><ul class="plain">{g.items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
      <h3 class="label langs-head">{c.cv.langTitle}</h3>
      <dl class="langs">
        {c.certs.map((x) => <div><dt>{x.k}</dt><dd>{x.v}</dd></div>)}
      </dl>
    </section>

    <section id="edu">
      <h2>{c.nav.edu}</h2>
      <ul class="plain edu">
        {c.edu.map((e) => (
          <li><span class="when mono">{e.when}</span><span><strong>{e.school}</strong><br /><span class="muted">{e.degree}</span></span></li>
        ))}
      </ul>
    </section>

    <section id="contact">
      <h2>{c.nav.contact}</h2>
      <p class="prose muted">{c.contactText}</p>
      <div class="ctas">
        <code class="mail" id="mail">{contact.email}</code>
        <button class="btn" type="button" id="copy" data-copy={c.copy} data-copied={c.copied}>{c.copy}</button>
      </div>
    </section>
  </main>

  <footer class="wrap foot mono">© {new Date().getFullYear()} Linfeng Chen</footer>
</Base>

<script>
  const b = document.getElementById('copy') as HTMLButtonElement | null;
  const mail = document.getElementById('mail');
  b?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(mail?.textContent ?? '');
      b.textContent = b.dataset.copied ?? '';
      setTimeout(() => (b.textContent = b.dataset.copy ?? ''), 1500);
    } catch {
      const r = document.createRange();
      if (mail) r.selectNodeContents(mail);
      const s = getSelection(); s?.removeAllRanges(); s?.addRange(r);
    }
  });
  document.getElementById('theme')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
  document.querySelectorAll<HTMLAnchorElement>('.lang a').forEach((a) =>
    a.addEventListener('click', () => { try { localStorage.setItem('lang', a.dataset.lang ?? ''); } catch {} }),
  );
</script>

<style>
  .wrap { max-width: 760px; margin: 0 auto; }
  .mono { font-family: var(--f-mono); }
  .muted { color: var(--muted); }

  .top { position: sticky; top: 0; z-index: 5; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(8px); margin: 0 calc(-1 * max(20px, env(safe-area-inset-left, 0px))); padding: env(safe-area-inset-top, 0px) max(20px, env(safe-area-inset-right, 0px)) 0; border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 24px; padding-block: 14px; }
  .mark { font: 500 14px var(--f-mono); text-decoration: none; }
  nav { display: flex; gap: 18px; margin-right: auto; white-space: nowrap; }
  nav a, .lang a { text-decoration: none; color: var(--muted); font-size: 14px; }
  nav a:hover, .lang a:hover { color: var(--ink); }
  .lang { display: flex; gap: 12px; white-space: nowrap; flex: none; }
  .theme { flex: none; }
  .lang a[aria-current='page'] { color: var(--ink); font-weight: 600; }

  .hero { padding-block: 72px 40px; }
  .theme { display: inline-grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--muted); cursor: pointer; padding: 0; }
  .theme:hover { color: var(--ink); border-color: var(--muted); }
  .theme .sun { display: none; }
  :global(:root[data-theme='dark']) .theme .sun { display: block; }
  :global(:root[data-theme='dark']) .theme .moon { display: none; }
  .stats { display: grid; margin: 0; }
  .stats div { display: flex; flex-direction: column; gap: 4px; padding: 16px 16px 16px 0; border-top: 1px solid var(--line); min-width: 0; }
  .stats dd { order: -1; margin: 0; font-weight: 600; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
  .stats dt { font-size: 13px; color: var(--muted); }
  .stats.big { grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); margin-bottom: 8px; }
  .stats.big dd { font-size: 1.5rem; }
  .stats.small { grid-template-columns: repeat(5, 1fr); border-bottom: 1px solid var(--line); margin-bottom: 32px; }
  .stats.small dd { font-size: 1.125rem; }
  .stats.small.three { grid-template-columns: repeat(3, 1fr); }
  .stats.small.four { grid-template-columns: repeat(4, 1fr); }
  .contrib-note { margin: -12px 0 16px; color: var(--muted); font-size: 15px; }
  .label.sub { margin: 0 0 12px; }
  .stats-head { margin: 0 0 10px; font-size: 12.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  h1 { font-size: clamp(2.25rem, 6vw, 3.25rem); line-height: 1.1; letter-spacing: -0.025em; margin: 0 0 8px; font-weight: 700; }
  .role { color: var(--muted); margin: 0 0 20px; }
  .tagline { font-size: 1.25rem; line-height: 1.5; margin: 0 0 32px; max-width: 30ch; text-wrap: balance; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); font: 500 14px/1 var(--f-sans); text-decoration: none; cursor: pointer; }
  .btn:hover { border-color: var(--muted); }
  .btn.primary { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .btn .mono { font-size: 12px; opacity: .7; }
  .cv-other { margin: 12px 0 0; display: flex; gap: 16px; font-size: 13px; }
  .cv-other a { color: var(--muted); }


  section { padding-block: 40px; }
  h2 { font-size: 13px; font-family: var(--f-mono); font-weight: 500; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin: 0 0 24px; }
  h3 { margin: 0; font-size: 1.0625rem; line-height: 1.4; font-weight: 600; }
  .prose { max-width: 65ch; margin: 0 0 1em; }

  .jobs { list-style: none; margin: 0; padding: 0; display: grid; gap: 36px; }
  .job { display: grid; grid-template-columns: 170px 1fr; gap: 16px; }
  .job-body { min-width: 0; }
  .when { font-size: 13px; color: var(--muted); padding-top: 2px; }
  .org { margin: 2px 0 0; color: var(--muted); }
  .metric { display: inline-block; margin: 10px 0 0; font-size: 12.5px; color: var(--accent); background: var(--accent-soft); padding: 3px 8px; border-radius: 6px; }
  .phase { margin-top: 16px; }
  .phase-head { margin: 0; font-weight: 500; }
  .phase-head .mono { font-size: 12.5px; color: var(--muted); margin-right: 6px; font-weight: 400; }
  .job ul { margin: 6px 0 0; padding-left: 1.1em; }
  .job li { margin: 4px 0; }

  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .card { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; min-width: 0; }
  .fig { background: var(--surface); border-bottom: 1px solid var(--line); }
  .card-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .card-body p { margin: 0; color: var(--muted); font-size: 15px; }
  .card-body .when { font-size: 12px; padding: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto !important; padding-top: 8px; }
  .tags span { font: 400 12px var(--f-mono); border: 1px solid var(--line); border-radius: 6px; padding: 2px 8px; color: var(--muted); }

  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 28px 32px; }
  .principles li { display: flex; gap: 14px; min-width: 0; }
  .principles .idx { font-size: 12px; color: var(--accent); padding-top: 3px; }
  .principles p { margin: 4px 0 0; color: var(--muted); font-size: 15px; }
  .nums { display: flex; gap: 20px; margin: 6px 0 0; flex-wrap: wrap; }
  .nums div { display: flex; flex-direction: column; }
  .nums dd { margin: 0; font-weight: 600; font-size: 1.125rem; color: var(--ink); font-variant-numeric: tabular-nums; }
  .nums dt { font-size: 12px; color: var(--muted); }
  .cols { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px 32px; }
  .cols > div { min-width: 0; }
  .label { font-size: 14px; margin-bottom: 8px; }
  .plain { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .langs-head { margin: 32px 0 10px; }
  .langs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin: 0; }
  .langs div { min-width: 0; }
  .langs dt { font-size: 13px; color: var(--muted); line-height: 1.4; }
  .langs dd { margin: 2px 0 0; line-height: 1.5; }
  .edu { gap: 16px; }
  .edu li { display: grid; grid-template-columns: 170px 1fr; gap: 16px; }

  .mail { font: 400 14px var(--f-mono); padding: 10px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); user-select: all; }
  .foot { padding-block: 32px 48px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12.5px; }

  @media (max-width: 820px) {
    nav { display: none; }
    .bar { justify-content: space-between; }
  }
  @media (max-width: 640px) {
    .bar { justify-content: space-between; }
    .hero { padding-block: 48px 32px; }
    .stats.big, .stats.small, .stats.small.three, .stats.small.four { grid-template-columns: 1fr 1fr; }
    .principles { grid-template-columns: 1fr; }
    .job, .edu li { grid-template-columns: 1fr; gap: 4px; }
    .cards, .cols { grid-template-columns: 1fr; }
    .langs { grid-template-columns: 1fr 1fr; }
  }
</style>
